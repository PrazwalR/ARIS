# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Data (keep placeholders)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Scoped to data/ deliberately: a blanket *.csv would also drop small test
# fixtures that M1 will need to commit.
data/**/*.csv
data/**/*.parquet

# Secrets
*.key
*.pem
salt.local
.hsm/
# Generated by scripts/generate_dev_certs.py -- local dev CA + per-bank certs
# for docker-compose.yml's mTLS listener (docs/SECURITY.md SS3.8). Ephemeral,
# regenerable, and *.pem above would already catch these; named explicitly
# so the whole tree is obviously excluded even before any files exist in it.
certs/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
