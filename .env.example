# Copy to .env and fill in. Never commit the real file.

# Consortium key used to derive risk_id = HMAC-SHA256(key, account).
# Must be hex or base64 encoding at least 32 random bytes -- a passphrase is
# rejected, because one known (account, risk_id) pair makes it recoverable.
#
# Generate one with:
#   python -c "from aris.hashing import generate_key; print(generate_key())"
#
# Every member bank must hold the SAME value or their risk IDs will not match.
# In deployment this comes from an HSM/KMS, not from a file. See docs/SECURITY.md.
ARIS_SALT=

# Set to 1 to use the public development key instead. Never set in production:
# the dev key is published in the source.
# ARIS_DEV_MODE=1

# M3 -- Kafka-backed risk bus (aris.kafka_bus). Defaults match docker-compose.yml
# for local dev; only set these to point at a different broker/registry.
# ARIS_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# ARIS_SCHEMA_REGISTRY_URL=http://localhost:8081
